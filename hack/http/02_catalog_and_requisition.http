### =========================================================================
### SpendSync API: 02. Catalog & Purchase Requisitions
### =========================================================================

@baseUrl = http://localhost:8080
@tenantId = 79ef8bff-1d87-4088-ab87-935989a568d5

### 1. Search Catalog Items
GET {{baseUrl}}/api/v1/catalog/search?query=MacBook&page=0&size=10
Authorization: Bearer {{cfoToken}}
X-Tenant-Id: {{tenantId}}

### 2. Get Hierarchical Category Tree
GET {{baseUrl}}/api/v1/catalog/categories
Authorization: Bearer {{cfoToken}}
X-Tenant-Id: {{tenantId}}

### 3. Get Catalog Health Metrics & Expiries
GET {{baseUrl}}/api/v1/catalog/health
Authorization: Bearer {{cfoToken}}
X-Tenant-Id: {{tenantId}}

### 4. Get Catalog Item Autofill Suggestions
GET {{baseUrl}}/api/v1/catalog/items/9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d/autofill
Authorization: Bearer {{cfoToken}}
X-Tenant-Id: {{tenantId}}

### 5. Create Purchase Requisition (PR)
# @name createPr
POST {{baseUrl}}/api/v1/requisitions
Authorization: Bearer {{reqToken}}
X-Tenant-Id: {{tenantId}}
Content-Type: application/json

{
  "legalEntityId": "09e3a0db-e890-4b01-b966-98026fb26fc7",
  "costCenterId": "cc100000-0000-0000-0000-000000000100",
  "facilityId": "fc100000-0000-0000-0000-000000000100",
  "currency": "TRY",
  "notes": "Q3 Development Team Infrastructure Upgrade",
  "lineItems": [
    {
      "itemDescription": "MacBook Pro 14 M3 Pro 36GB RAM",
      "categoryCode": "CAT-HW-LAPTOP",
      "quantity": 2,
      "unitOfMeasure": "PIECE",
      "estimatedUnitPrice": 85000.00,
      "taxRate": 0.20,
      "suggestedVendorId": "vd100000-0000-0000-0000-000000000100"
    }
  ]
}

> {%
    client.global.set("createdPrId", response.body.id);
%}

### 6. List My Requisitions
GET {{baseUrl}}/api/v1/requisitions/my-requisitions
Authorization: Bearer {{reqToken}}
X-Tenant-Id: {{tenantId}}

### 7. List Pending Approvals
GET {{baseUrl}}/api/v1/requisitions/pending-approvals
Authorization: Bearer {{cfoToken}}
X-Tenant-Id: {{tenantId}}

### 8. Approve Requisition (Executive Level)
POST {{baseUrl}}/api/v1/requisitions/{{createdPrId}}/approve
Authorization: Bearer {{cfoToken}}
X-Tenant-Id: {{tenantId}}
Content-Type: application/json

{
  "decisionNotes": "Approved within Q3 CapEx engineering budget allocation."
}
